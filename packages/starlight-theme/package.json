{
  "name": "@abstractdata/starlight-theme",
  "version": "0.3.0",
  "description": "Branded Astro Starlight theme by Abstract Data — HUD and Calm surfaces, light + dark, motion-aware.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.d.ts",
    "./shiki": "./src/shiki/index.ts",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./assets/*": "./src/assets/*"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "astro",
    "starlight",
    "starlight-theme",
    "documentation",
    "abstract-data"
  ],
  "homepage": "https://github.com/Abstract-Data/abstract-data-doc-theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abstract-Data/abstract-data-doc-theme.git",
    "directory": "packages/starlight-theme"
  },
  "license": "MIT",
  "author": "Abstract Data <dev@abstractdata.io>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/orbitron": "^5.0.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0",
    "astro": ">=5.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.34.0",
    "astro": "^5.10.0",
    "typescript": "^5.6.0"
  }
}
